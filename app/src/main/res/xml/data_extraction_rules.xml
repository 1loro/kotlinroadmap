<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: qué datos pueden salir del dispositivo. Para una app con datos
     financieros: NADA, ni a la copia de seguridad en la nube ni al pasar los
     datos a un teléfono nuevo. (Además, la BD solo se puede abrir con una
     clave que vive en el Keystore de ESTE teléfono.) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
